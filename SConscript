import os
from building import *

cwd = GetCurrentDir()
sdk_root = os.environ.get('AIC_ROOT') or os.path.normpath(
    os.path.join(cwd, '..', '..', '..'))

try:
    repo = GetConfigValue('RTCARPLAY_DIR')
except KeyError:
    repo = ''
repo = repo.strip('"')

if not repo:
    repo = os.path.join(sdk_root, 'packages', 'third-party', 'rt-carplay')
if not os.path.isabs(repo):
    repo = os.path.join(cwd, repo)
repo = os.path.normpath(repo)

src = Glob('main.c') + Glob('app/carplay_app.c')
if GetDepend('RTCARPLAY_DEMO_LAUNCHER'):
    src += Glob('ui/*.c')
    src += Glob('ui/fonts/*.c')
    # Lucide A8 masks generated by tools/generate_icon_assets.py.
    src += Glob('ui/icons/*.c')
    # Real local backends used by the Settings page; both compile to a
    # disabled stub when the image has no audio/PWM driver.
    src += Glob('platform/audio_volume_lubanlite.c')
    src += Glob('platform/backlight_lubanlite.c')
if GetDepend('RTCARPLAY_D213_BOARD_KEYS'):
    src += Glob('platform/board_keys_lubanlite.c')
if GetDepend('RTCARPLAY_SINGLE_SCREEN_FUSION'):
    src += Glob('app/fusion_display.c')
if GetDepend('RTCARPLAY_VEHICLE_PROTOCOL_DEMO'):
    src += Glob('app/vehicle_protocol_demo.c')
if GetDepend('RTCARPLAY_AUTO_CONNECT'):
    src += Glob('app/connection_manager.c')
    src += Glob('app/launcher_preferences.c')
if GetDepend('RTCARPLAY_INTERNET_SHARE'):
    src += Glob('platform/internet_share_lubanlite.c')
if GetDepend('RTCARPLAY_OTA'):
    src += Glob('platform/ota_lubanlite.c')
    if GetDepend('AIC_WLAN_REALTEK'):
        src += Glob('platform/wifi_sta_lubanlite.c')
if GetDepend('RTCARPLAY_OTA') or GetDepend('RTCARPLAY_INTERNET_SHARE'):
    src += Glob('app/network_manager.c')
if GetDepend('RTCARPLAY_NETWORK_TIME'):
    src += Glob('platform/network_time_lubanlite.c')
cpppath = [cwd, cwd + '/app', cwd + '/platform']
if GetDepend('RTCARPLAY_SINGLE_SCREEN_FUSION'):
    cpppath.append(os.path.join(sdk_root, 'packages', 'artinchip', 'lvgl-ui',
                                'lvgl_v9', 'lvgl', 'src', 'font'))
if GetDepend('RTCARPLAY_USB_FILE_SYNC'):
    # Application composition: reuse the upstream class, sync service, DFS
    # adapter and development descriptors. Do not link its shell.
    usb_root = os.path.join(sdk_root, 'packages', 'third-party', 'cherryusb')
    src += Glob('platform/usb_file_sync.c')
    for source in ('class/adb/usbd_adb.c', 'class/adb/usbd_adb_sync.c',
                   'demo/adb_template.c'):
        src += Glob(os.path.join(usb_root, source))
    # newlib defines st_mtime as st_mtim.tv_sec, colliding with the upstream
    # VFS field name. Compile a narrowly adapted copy, leaving upstream intact.
    import building
    def prepare_usb_vfs(target, source, env):
        import subprocess, sys
        return subprocess.call([sys.executable, str(source[1]),
                                str(source[0]), str(target[0])])
    src += building.Env.Command(
        os.path.join(cwd, 'generated/rt_vfs_dfs.c'),
        [os.path.join(usb_root, 'platform/rtthread/rt_vfs_dfs.c'),
         os.path.join(cwd, 'tools/prepare_usb_vfs.py')], prepare_usb_vfs)
    cpppath += [os.path.join(usb_root, directory)
                for directory in ('common', 'core', 'class/adb')]
    cpppath.append(os.path.join(sdk_root, 'packages', 'third-party',
                                'cherryusb-luban'))
src += Glob('app/pairing_files.c') + Glob('platform/carplay_mfi_provider.c')
if GetDepend('RTCARPLAY_AUTO_CONNECT'):
    src += Glob('app/pairing_manager.c')
if GetDepend('RTCARPLAY_VIDEO'):
    src += Glob('platform/video_sink_lubanlite.c')
if GetDepend('RTCARPLAY_AUDIO'):
    src += Glob('platform/audio_sink_lubanlite.c')
if GetDepend('RTCARPLAY_MICROPHONE'):
    src += Glob('platform/audio_input_lubanlite.c')
if GetDepend('RTCARPLAY_TOUCH_PANEL'):
    src += Glob('platform/touch_panel_lubanlite.c')
if GetDepend('RTCARPLAY_IAP2'):
    src += Glob('app/iap2_link_lubanlite.c')
    src += Glob('app/gnss_demo.c')
if GetDepend('RTCARPLAY_USB_HOST'):
    src += Glob('app/carplay_usb_cmd.c') + Glob('app/usb_pair_cache.c')

# Luban-Lite board seams.  The include directory is shared by the Wi-Fi,
# Bluetooth and MFi sources (rtcp_lubanlite.h declares all three interfaces).
if (GetDepend('LPKG_RT_CARPLAY_LUBANLITE_WIFI') or
        GetDepend('LPKG_RT_CARPLAY_LUBANLITE_BT') or
        GetDepend('LPKG_RT_CARPLAY_LUBANLITE_MFI') or
        GetDepend('LPKG_RT_CARPLAY_LUBANLITE_USB')):
    cpppath.append(cwd + '/platform')

# Luban-Lite Wi-Fi seam (SoftAP + vendor IE).
if GetDepend('LPKG_RT_CARPLAY_LUBANLITE_WIFI'):
    src += Glob('platform/rtcp_wifi_lubanlite.c')

    # The Realtek API headers live outside the SDK's global include path;
    # the driver SConscript adds them only to its own group.
    aic_root = os.environ.get('AIC_ROOT', '')
    if aic_root and GetDepend('AIC_WLAN_REALTEK'):
        realtek = os.path.join(aic_root, 'bsp', 'peripheral', 'wireless',
                               'realtek')
        for sub in ('api/wifi', 'api', 'include', 'os/os_dep/include',
                    'platform/include', 'platform/rtwlan_bsp'):
            cpppath.append(os.path.join(realtek, sub))
    if GetDepend('AIC8800_AP_VENDOR_IE'):
        cpppath.append(os.path.join(sdk_root, 'bsp', 'peripheral', 'wireless',
                                    'aic8800', 'platform', 'wifi'))

# CE TRNG, used for AirPlay pairing and for the wired lockdown pair record.
if (GetDepend('LPKG_RT_CARPLAY_LUBANLITE_WIFI') or
        GetDepend('LPKG_RT_CARPLAY_LUBANLITE_USB')):
    src += Glob('platform/rtcp_random_lubanlite.c')

# Luban-Lite Bluetooth seam: Zephyr Classic BR/EDR + RFCOMM for iAP2.
if GetDepend('LPKG_RT_CARPLAY_LUBANLITE_BT'):
    src += Glob('platform/rtcp_bt_lubanlite.c')

    # The zephyr-bluetooth package ships no settings core; this file backs
    # CONFIG_BT_SETTINGS with an RT-Thread DFS file so BR/EDR link keys (and
    # therefore the phone's bond) survive a reboot.
    if GetDepend('LPKG_BT_SETTINGS'):
        src += Glob('platform/rtcp_bt_settings.c')

    aic_root = os.environ.get('AIC_ROOT', '')
    if aic_root:
        zephyr = os.path.join(aic_root, 'packages', 'third-party',
                              'zephyr-bluetooth')
        cpppath.append(os.path.join(zephyr, 'include'))
        cpppath.append(os.path.join(zephyr, 'porting'))

# Luban-Lite MFi seam: 2.0C authentication coprocessor on the I2C bus.
if GetDepend('LPKG_RT_CARPLAY_LUBANLITE_MFI'):
    src += Glob('platform/rtcp_mfi_lubanlite.c')

if GetDepend('RTCARPLAY_MICROPHONE'):
    src += Glob('platform/rtcp_audio_capture_lubanlite.c')
    cpppath.append(cwd + '/platform')

# Luban-Lite wired USB host seam: CherryUSB host stack, Apple USBMUX class
# driver and the configuration-selection hook.  The CherryUSB headers are
# only added to this group (the stack builds its own copy with its own paths).
if GetDepend('LPKG_RT_CARPLAY_LUBANLITE_USB'):
    src += Glob('platform/rtcp_usb_lubanlite.c')
    if GetDepend('RTCARPLAY_NATIVE_NCM'):
        if GetDepend('LPKG_USING_CHERRYUSB_IPHETH') or GetDepend('LPKG_CHERRYUSB_HOST_NCM'):
            raise RuntimeError('Native CarPlay NCM requires exclusive USB network ownership; disable IPHETH and upstream NCM')
        src += Glob('platform/native_ncm_codec.c')
        src += Glob('platform/native_ncm_lubanlite.c')

    # NCM netdev helpers; the CherryUSB NCM class needs lwIP.
    if GetDepend('RT_USING_LWIP'):
        src += Glob('platform/rtcp_net_lubanlite.c')

    aic_root = os.environ.get('AIC_ROOT', '')
    if aic_root:
        cherryusb = os.path.join(aic_root, 'packages', 'third-party',
                                 'cherryusb')
        cpppath.append(os.path.join(cherryusb, 'common'))
        cpppath.append(os.path.join(cherryusb, 'core'))

# These sources previously inherited the SDK group's force-included logger.
# Keep that provider local to the host group after moving the implementations.
ccflags = ''
if GetDepend('LPKG_RT_CARPLAY_LOG'):
    ccflags = '-include ' + os.path.join(
        repo, 'port', 'rtthread', 'include', 'rtcp_log_rtthread.h')

# Firmware version shown on the Settings page. image_cfg.json is the single
# source of truth: mkcpio.py copies the same string into the OTA package.
def firmware_version():
    chip = GetDepend('PRJ_CHIP')
    board = GetDepend('PRJ_BOARD')
    if not isinstance(chip, str) or not isinstance(board, str):
        return 'unknown'
    path = os.path.join(sdk_root, 'target', chip.strip('"'), board.strip('"'),
                        'pack', 'image_cfg.json')
    try:
        import json
        with open(path) as cfg:
            # image_cfg.json allows // comments; strip them before parsing.
            text = ''.join(line.split('//')[0].strip()
                           for line in cfg.readlines())
        text = text.replace(',}', '}').replace(',]', ']')
        return str(json.loads(text)['image']['info']['version'])
    except Exception as error:
        print('[rtcarplay] firmware version unavailable: %s' % error)
        return 'unknown'

# Commit hash of the running image; the nightly channel treats a different
# published hash as a new build even when the version string is unchanged.
def build_commit():
    try:
        import subprocess
        import re
        override = os.environ.get('RTCARPLAY_BUILD_COMMIT', '')
        if override:
            if not re.match(r'^[0-9a-f]{40}$', override):
                raise ValueError('invalid RTCARPLAY_BUILD_COMMIT')
            return override
        out = subprocess.check_output(['git', 'rev-parse', 'HEAD'], cwd=sdk_root)
        if not isinstance(out, str):
            out = out.decode('ascii', 'replace')
        dirty = subprocess.check_output(
            ['git', 'status', '--porcelain', '--untracked-files=no'],
            cwd=sdk_root)
        return out.strip() + ('-dirty' if dirty.strip() else '')
    except Exception as error:
        print('[rtcarplay] build commit unavailable: %s' % error)
        return 'unknown'

# The values are passed unquoted and stringified in C: quoted definitions do
# not survive SCons' command-line splitting on every host.
commit = build_commit()
cppdefines = ['MBEDTLS_CHACHA20_C', 'MBEDTLS_CHACHAPOLY_C',
              'MBEDTLS_HKDF_C',
              'RTCARPLAY_FW_VERSION=%s' % firmware_version(),
              'RTCARPLAY_BUILD_COMMIT=%s' % commit]

group = DefineGroup('Applications', src, depend=[''], CPPPATH=cpppath,
                    LOCAL_CCFLAGS=ccflags,
                    CPPDEFINES=cppdefines)

if GetDepend('RTCARPLAY_DEMO_LAUNCHER'):
    import time
    epoch = os.environ.get('SOURCE_DATE_EPOCH')
    build_time = time.gmtime(int(epoch)) if epoch is not None else time.gmtime()
    timestamp = time.strftime('%Y-%m-%dT%H:%M:%SZ', build_time)
    build_info_group = DefineGroup('CarPlay build info', Glob('platform/carplay_build_info.c'),
                                   depend=[''], LOCAL_CPPPATH=[os.path.join(repo, 'include')],
                                   LOCAL_CPPDEFINES=['RTCARPLAY_BUILD_TIME_UTC=%s' % timestamp])
    group = group + build_info_group

app_sconscript = os.path.join(repo, 'SConscript')
if not os.path.isfile(app_sconscript):
    raise RuntimeError(
        'rt-carplay source not found at ' + repo +
        '; run "git submodule update --init packages/third-party/rt-carplay"'
        ' or set CONFIG_RTCARPLAY_DIR')

import building
if not any(project.get('name') == 'rt-carplay' for project in building.Projects):
    group = group + SConscript(app_sconscript)

Return('group')
